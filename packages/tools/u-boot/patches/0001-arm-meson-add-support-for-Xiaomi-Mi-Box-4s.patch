From: vpnusageo3 <vpnusageo3@gmail.com>

Subject: [PATCH] arm: meson: add support for Xiaomi Mi Box 4S (MDZ-22-AB/S905X)

Add U-Boot defconfig, u-boot.dtsi and upstream board DTS for Xiaomi Mi Box 4S.
---

 arch/arm/dts/meson-gxl-s905x-xiaomi-mibox4s-u-boot.dtsi          |  62 +++

 configs/mibox4s_defconfig                                       |  54 +++

 dts/upstream/src/arm64/amlogic/meson-gxl-s905x-xiaomi-mibox4s.dts | 348 +++

 3 files changed, 464 insertions(+)

 create mode 100644 arch/arm/dts/meson-gxl-s905x-xiaomi-mibox4s-u-boot.dtsi

 create mode 100644 configs/mibox4s_defconfig

 create mode 100644 dts/upstream/src/arm64/amlogic/meson-gxl-s905x-xiaomi-mibox4s.dts

diff --git a/arch/arm/dts/meson-gxl-s905x-xiaomi-mibox4s-u-boot.dtsi b/arch/arm/dts/meson-gxl-s905x-xiaomi-mibox4s-u-boot.dtsi
new file mode 100644
index 0000000000..0c5dd59421
--- /dev/null
+++ b/arch/arm/dts/meson-gxl-s905x-xiaomi-mibox4s-u-boot.dtsi
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+#include "meson-gxl-u-boot.dtsi"
+
+/ {
+	aliases {
+		mmc0 = &sd_emmc_c;
+		/delete-property/ mmc1;
+		/delete-property/ mmc2;
+	};
+};
+
+&gpio {
+	power-led-hog {
+		gpio-hog;
+		gpios = <GPIOX_6 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "mibox4s-power-led";
+	};
+};
+
+&gpio_ao {
+	hdmi-usb-5v-hog {
+		gpio-hog;
+		gpios = <GPIOAO_4 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "mibox4s-hdmi-usb-5v";
+	};
+};
+
+&hdmi_usb_5v {
+	status = "disabled";
+};
+
+&leds {
+	status = "disabled";
+};
+
+&hdmi_tx {
+	/delete-property/ hdmi-supply;
+};
+
+&usb2_phy0 {
+	/delete-property/ phy-supply;
+};
+
+&sd_emmc_a {
+	status = "disabled";
+};
+
+&uart_A {
+	status = "disabled";
+};
+
+&sd_emmc_c {
+	bootph-all;
+};
+
+&uart_AO {
+	bootph-all;
+};
diff --git a/configs/mibox4s_defconfig b/configs/mibox4s_defconfig
new file mode 100644
index 0000000000..ba52c6e1b7
--- /dev/null
+++ b/configs/mibox4s_defconfig
@@ -0,0 +1,54 @@
+CONFIG_ARM=y
+CONFIG_SYS_BOARD="mibox4s"
+CONFIG_ARCH_MESON=y
+CONFIG_TEXT_BASE=0x01000000
+CONFIG_NR_DRAM_BANKS=1
